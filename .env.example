# Non-secret runtime settings for local development.
# Copy to .env. Never put credentials or feed-token values in this file.

BRIDGE_PORT=8788
BRIDGE_LOG_LEVEL=INFO
DATA_DIR=./data
SECRETS_DIR=./secrets

# Run setup once before the first `docker compose up`:
#   docker compose run --rm bridge setup            # live (prompts for key)
#   docker compose run --rm bridge setup --sample   # offline sample mode
#
# For live mode, place these owner-only files inside SECRETS_DIR; the bridge
# reads them from /run/secrets and never logs their contents:
#   coinbase_api_key_name      Coinbase CDP API key name (view-only key)
#   coinbase_api_private_key   the key's unencrypted ECDSA PEM private key
#
# Device bearer tokens are created with `bridge device add`; transfer the token
# file to the display. Never store device or Coinbase secrets in this file.
