<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homardsimpson.coinbase-amoled-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>@EXECUTABLE_XML@</string>
        <string>--data-dir</string>
        <string>@DATA_DIR_XML@</string>
        <string>serve</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--allow-insecure-public-bind</string>
@SAMPLE_ARG_XML@    </array>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>Umask</key>
    <integer>63</integer>
</dict>
</plist>
